# Modelo de .env para o deploy em produção no RHSA342 (rede proxy_net),
# seguindo o mesmo padrão usado pelo Ender Contatos.
# Copie para backend/.env no servidor e ajuste conforme o ambiente Datasul
# a ser usado (desenv/homol/produção).

APP_ENV=production
COOKIE_SECURE=true
SESSION_TTL_SECONDS=1800

# --- TOTVS Datasul (login por formulário / Spring Security) ---
DATASUL_BASE_URL=https://SEU-HOST-DATASUL
DATASUL_LOGIN_FORM_PATH=/totvs-login/loginForm
DATASUL_LOGIN_ACTION_PATH=/totvs-login/ACS?login
DATASUL_DOMAIN=RHSA
DATASUL_LANG=pt

DATASUL_VERIFY_SSL=true
DATASUL_TIMEOUT=15
