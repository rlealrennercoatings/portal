# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente.

APP_ENV=development
COOKIE_SECURE=false
SESSION_TTL_SECONDS=3600

# --- TOTVS Datasul ---
# Host do ambiente (ex: https://erp-desenv.renner.com.br ou https://erp-2cloud.renner.com.br)
DATASUL_BASE_URL=https://SEU-HOST-DATASUL
DATASUL_TOKEN_PATH=/totvs-login/connect/token
DATASUL_GRANT_TYPE=password

DATASUL_CLIENT_ID=
DATASUL_CLIENT_SECRET=
DATASUL_SCOPE=
DATASUL_COMPANY=

DATASUL_VERIFY_SSL=true
DATASUL_TIMEOUT=15
