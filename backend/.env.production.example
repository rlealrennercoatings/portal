# Modelo de .env para o deploy em produção no RHSA342 (rede nginx_proxy),
# seguindo o mesmo padrão usado pelo Ender Contatos.
# Copie para backend/.env no servidor e ajuste as credenciais reais.

APP_ENV=production
COOKIE_SECURE=true
SESSION_TTL_SECONDS=3600

# --- TOTVS Datasul ---
DATASUL_BASE_URL=https://SEU-HOST-DATASUL
DATASUL_TOKEN_PATH=/totvs-login/connect/token
DATASUL_GRANT_TYPE=password

DATASUL_CLIENT_ID=
DATASUL_CLIENT_SECRET=
DATASUL_SCOPE=
DATASUL_COMPANY=

DATASUL_VERIFY_SSL=true
DATASUL_TIMEOUT=15
