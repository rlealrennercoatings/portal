# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente.

APP_ENV=development
COOKIE_SECURE=false
SESSION_TTL_SECONDS=1800

# --- TOTVS Datasul (login por formulário / Spring Security) ---
# Host do ambiente (ex: https://erp-chile-desenv.renner.com.br)
DATASUL_BASE_URL=https://SEU-HOST-DATASUL
DATASUL_LOGIN_FORM_PATH=/totvs-login/loginForm
DATASUL_LOGIN_ACTION_PATH=/totvs-login/ACS?login
DATASUL_DOMAIN=RHSA
DATASUL_LANG=pt

DATASUL_VERIFY_SSL=true
DATASUL_TIMEOUT=15
